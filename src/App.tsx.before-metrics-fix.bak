import { useEffect, useState } from "react";

const fakeSample =
  "Doctors have drawn up a list of dozens of treatments they say are of little or no use. It is part of a campaign to cut down on unnecessary procedures, with experts warning that more does not always mean better.";

const realSample =
  "Scientists have released a new study examining how coastal ecosystems respond to rising temperatures. The peer-reviewed research combines field observations collected over twelve years.";

type ModelVote = {
  model: string;
  p_real: number;
};

type PredictionResult = {
  p_real: number;
  verdict: "real" | "fake" | "uncertain";
  votes: ModelVote[];
  words: Record<string, number>;
  short: boolean;
};

type ModelMetric = {
  name: string;
  accuracy: number;
  precision: number;
  recall: number;
  f1: number;
};

type InfoData = {
  dataset: string;
  n_test: number;
  models: ModelMetric[];
};

type IconProps = {
  name: "arrow" | "check" | "chevron" | "shield" | "spark" | "alert" | "info";
  className?: string;
};

function Icon({ name, className = "h-5 w-5" }: IconProps) {
  const paths = {
    arrow: <path d="M5 12h14m-5-5 5 5-5 5" />,
    check: <path d="m5 12 4 4L19 6" />,
    chevron: <path d="m9 18 6-6-6-6" />,
    shield: <path d="M12 3 5 6v5c0 4.6 2.9 8.2 7 10 4.1-1.8 7-5.4 7-10V6l-7-3Z" />,
    spark: <path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z" />,
    alert: <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />,
    info: <g><circle cx="12" cy="12" r="10" /><path d="M12 16v-4m0-4h.01" /></g>,
  };

  return (
    <svg
      aria-hidden="true"
      className={className}
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      {paths[name]}
    </svg>
  );
}

function navigate(path: string) {
  window.history.pushState({}, "", path);
  window.dispatchEvent(new PopStateEvent("popstate"));
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function Header({ page }: { page: "analyzer" | "accuracy" }) {
  return (
    <header className="relative z-20 border-b border-[#414743] bg-[#2b2f2d]">
      <div className="mx-auto grid h-16 max-w-7xl grid-cols-[1fr_auto] items-center px-5 sm:grid-cols-[1fr_auto_1fr] sm:px-8">
        <button
          className="group flex w-fit items-center"
          onClick={() => navigate("/")}
          aria-label="Get Legit home"
        >
          <span className="h-10 w-10 overflow-hidden rounded-[0.65rem] shadow-[0_0_18px_rgba(16,185,129,.2)]">
            <img
              className="h-full w-full scale-[1.15] object-cover"
              src="/get-legit-logo.png"
              alt="Get Legit"
            />
          </span>
        </button>

        <nav className="flex items-center justify-center gap-7 text-xs font-medium">
          <button
            className={`relative py-2 transition ${
              page === "analyzer" ? "text-white" : "text-[#aab3ae] hover:text-white"
            }`}
            onClick={() => navigate("/")}
          >
            Analyzer
            {page === "analyzer" && (
              <span className="absolute inset-x-0 -bottom-0.5 mx-auto h-px w-5 bg-emerald-400" />
            )}
          </button>
          <button
            className={`relative py-2 transition ${
              page === "accuracy" ? "text-white" : "text-[#aab3ae] hover:text-white"
            }`}
            onClick={() => navigate("/accuracy")}
          >
            Accuracy
            {page === "accuracy" && (
              <span className="absolute inset-x-0 -bottom-0.5 mx-auto h-px w-5 bg-emerald-400" />
            )}
          </button>
        </nav>

        <div className="hidden justify-end sm:flex">
          <button
            className="rounded-full bg-[#f7f3ea] px-4 py-2 text-xs font-semibold text-[#173c2e] transition hover:bg-white"
            onClick={() => {
              if (page === "analyzer") {
                document.getElementById("analyzer")?.scrollIntoView({ behavior: "smooth" });
              } else {
                navigate("/");
              }
            }}
          >
            Check an article
          </button>
        </div>
      </div>
    </header>
  );
}

function Analyzer() {
  const [article, setArticle] = useState("");
  const [result, setResult] = useState<PredictionResult | null>(null);
  const [analyzing, setAnalyzing] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const analyze = async () => {
    const text = article.trim();
    if (!text || analyzing) return;
    setAnalyzing(true);
    setError(null);
    setResult(null);
    try {
      const response = await fetch("/api/predict", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text }),
      });
      const data = await response.json();
      if (!response.ok) {
        setError(data.error || "Failed to analyze article.");
      } else {
        setResult(data);
      }
    } catch {
      setError("Could not reach the server. Is server.py running?");
    } finally {
      setAnalyzing(false);
    }
  };

  const loadSample = async (label: number) => {
    setError(null);
    setResult(null);
    try {
      const res = await fetch(`/api/example?label=${label}`);
      if (res.ok) {
        const data = await res.json();
        if (data.text) {
          setArticle(data.text);
          return;
        }
      }
    } catch {
      // Fallback to static sample if API call fails
    }
    setArticle(label === 1 ? realSample : fakeSample);
  };

  const isReal = result?.verdict === "real";
  const isFake = result?.verdict === "fake";
  const isUncertain = result?.verdict === "uncertain";

  const verdictLabel = isUncertain
    ? "Uncertain / Inconclusive"
    : isReal
      ? "Likely real"
      : "Likely misleading";

  const confidenceScore = result
    ? (Math.max(result.p_real, 1 - result.p_real) * 100).toFixed(1)
    : "0";

  const advisoryNotes: string[] = [];
  if (result) {
    if (result.verdict === "uncertain") {
      advisoryNotes.push("Too close to call — verify with a fact-checker.");
    }
    if (result.short) {
      advisoryNotes.push("Short input: models were trained on full articles, so this is less reliable.");
    }
    const nReal = result.votes.filter((v) => v.p_real > 0.5).length;
    if (nReal !== 0 && nReal !== result.votes.length) {
      advisoryNotes.push(`Models disagree (${nReal} of ${result.votes.length} say real).`);
    }
  }

  const wordMags = result ? Object.values(result.words).map(Math.abs).sort((a, b) => a - b) : [];
  const wordThreshold = wordMags.length ? wordMags[Math.floor(wordMags.length * 0.85)] : 0;

  return (
    <>
      <Header page="analyzer" />
      <main>
        <section className="relative overflow-hidden px-5 pb-20 pt-16 sm:px-8 sm:pt-20">
          <div className="relative mx-auto max-w-6xl">
            <div className="mx-auto max-w-4xl text-center">
              <h1 className="hero-heading text-balance text-[44px] leading-[0.96] tracking-[-0.04em] text-[#12382b] sm:text-[64px]">
                <span className="hero-pop block">Know what&apos;s real.</span>
                <span className="hero-pop hero-pop-delayed block">Question what isn&apos;t.</span>
              </h1>
              <p className="mx-auto mt-5 max-w-xl text-sm leading-6 text-[#64746d] sm:text-base">
                Get a clear, instant credibility check for any news article before you trust or
                share it.
              </p>
              <div className="mt-6 flex items-center justify-center gap-7 text-sm font-semibold">
                <button
                  className="text-[#07543d] underline decoration-[#07543d]/40 decoration-2 underline-offset-4 transition hover:text-[#0b7654]"
                  onClick={() => document.getElementById("analyzer")?.scrollIntoView({ behavior: "smooth" })}
                >
                  Try the analyzer
                </button>
                <button
                  className="text-[#53675e] underline decoration-[#53675e]/30 decoration-2 underline-offset-4 transition hover:text-[#07543d]"
                  onClick={() => navigate("/accuracy")}
                >
                  View accuracy
                </button>
              </div>
            </div>

            <div className="relative mx-auto mt-8 flex min-h-72 max-w-6xl items-center justify-center sm:min-h-[430px]">
              <div className="absolute bottom-8 left-1/2 h-52 w-[70%] -translate-x-1/2 rounded-[50%] bg-[#ece8a8]/45 blur-2xl" />
              <div className="whirlwind-effect" aria-hidden="true" />
              <div className="whirlwind-effect whirlwind-effect-two" aria-hidden="true" />
              <div className="floating-proof proof-left hidden lg:flex">
                <span className="proof-icon">
                  <Icon name="spark" className="h-4 w-4" />
                </span>
                <span>
                  <strong>Fast review</strong>
                  <small>Results in seconds</small>
                </span>
              </div>
              <div className="floating-proof proof-right hidden lg:flex">
                <span className="proof-icon">
                  <Icon name="check" className="h-4 w-4" />
                </span>
                <span>
                  <strong>Clear verdict</strong>
                  <small>Easy to understand</small>
                </span>
              </div>
              <div className="floating-proof proof-top-left hidden lg:flex">
                <span className="proof-icon">
                  <Icon name="shield" className="h-4 w-4" />
                </span>
                <span>
                  <strong>Source signals</strong>
                  <small>Context-aware review</small>
                </span>
              </div>
              <div className="floating-proof proof-bottom-right hidden lg:flex">
                <span className="proof-icon">
                  <Icon name="spark" className="h-4 w-4" />
                </span>
                <span>
                  <strong>Confidence score</strong>
                  <small>Clear at a glance</small>
                </span>
              </div>
              <img
                className="hero-illustration relative z-10 w-full max-w-2xl object-contain"
                src="/news-analysis-illustration.png"
                alt="People comparing trustworthy and misleading news stories"
              />
            </div>

            <div className="relative mx-auto mt-8 max-w-5xl scroll-mt-8" id="analyzer">
              <div className="analyzer-card rounded-[1.75rem] border border-[#d8e0d9] p-3 shadow-xl shadow-emerald-950/5 sm:p-5">
                <div className="flex items-center justify-between px-2 pb-4">
                  <span className="flex items-center gap-2 text-sm font-medium text-[#254c3d]">
                    <Icon name="spark" className="h-4 w-4 text-emerald-600" />
                    Article content
                  </span>
                  <span className="text-xs text-[#819087]">{article.length.toLocaleString()} characters</span>
                </div>
                <textarea
                  value={article}
                  onChange={(event) => {
                    setArticle(event.target.value);
                    setResult(null);
                    setError(null);
                  }}
                  className="min-h-52 w-full resize-none rounded-2xl border border-[#dbe2dc] bg-[#fafbf7] p-5 text-base leading-7 text-[#183a2e] outline-none transition placeholder:text-[#9aa89f] focus:border-emerald-600/60 focus:ring-4 focus:ring-emerald-500/10"
                  placeholder="Paste the full text of a news article here..."
                />

                {error && (
                  <div className="mt-4 flex items-center gap-3 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">
                    <Icon name="alert" className="h-5 w-5 shrink-0 text-rose-600" />
                    <span>{error}</span>
                  </div>
                )}

                <div className="flex flex-col gap-4 px-1 pb-1 pt-4 sm:flex-row sm:items-center sm:justify-between">
                  <div className="flex flex-wrap items-center gap-4 text-sm text-[#718078]">
                    <span>Try a sample:</span>
                    <button className="sample-link" onClick={() => loadSample(1)}>
                      Real article
                    </button>
                    <button className="sample-link" onClick={() => loadSample(0)}>
                      Misleading article
                    </button>
                    {article && (
                      <>
                        <span className="text-[#d8e0d9]">|</span>
                        <button
                          className="sample-link text-[#8b9991]"
                          onClick={() => {
                            setArticle("");
                            setResult(null);
                            setError(null);
                          }}
                        >
                          Clear
                        </button>
                      </>
                    )}
                  </div>
                  <button
                    className="analyze-button flex min-w-40 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-sm font-semibold text-white transition disabled:cursor-not-allowed disabled:opacity-40"
                    disabled={!article.trim() || analyzing}
                    onClick={analyze}
                  >
                    {analyzing ? "Analyzing..." : "Analyze article"}
                    {!analyzing && <Icon name="arrow" className="h-4 w-4" />}
                  </button>
                </div>
              </div>

              {result && (
                <div className="mt-6 flex flex-col gap-4">
                  <div
                    className={`result-card flex flex-col gap-5 rounded-2xl border p-6 sm:flex-row sm:items-center sm:justify-between ${
                      isReal
                        ? "border-emerald-700/20 bg-[#e9f3eb]"
                        : isFake
                          ? "border-rose-700/20 bg-[#faebea]"
                          : "border-amber-700/20 bg-[#fdf5e6]"
                    }`}
                  >
                    <div className="flex items-center gap-4">
                      <span
                        className={`grid h-12 w-12 shrink-0 place-items-center rounded-full ${
                          isReal
                            ? "bg-emerald-700/10 text-emerald-700"
                            : isFake
                              ? "bg-rose-700/10 text-rose-700"
                              : "bg-amber-700/10 text-amber-700"
                        }`}
                      >
                        <Icon name={isReal ? "check" : isFake ? "alert" : "info"} />
                      </span>
                      <div>
                        <p
                          className={`text-xs font-semibold uppercase tracking-[0.16em] ${
                            isReal ? "text-emerald-700" : isFake ? "text-rose-700" : "text-amber-800"
                          }`}
                        >
                          Analysis complete
                        </p>
                        <p className="mt-1 text-xl font-semibold text-[#123c2d]">{verdictLabel}</p>
                      </div>
                    </div>
                    <div className="sm:text-right">
                      <p className="text-3xl font-semibold tracking-tight text-[#123c2d]">{confidenceScore}%</p>
                      <p className="text-sm text-[#708078]">confidence score</p>
                    </div>
                  </div>

                  <div className="rounded-2xl border border-[#d8e0d9] bg-white/70 p-5 shadow-sm">
                    <div className="flex items-center justify-between text-xs font-semibold text-[#718078]">
                      <span className="text-rose-700">Fake</span>
                      <span className="font-mono text-[#173c2e]">P(real) {(result.p_real * 100).toFixed(1)}%</span>
                      <span className="text-emerald-700">Real</span>
                    </div>
                    <div className="mt-2.5 h-3 w-full overflow-hidden rounded-full bg-[#e5ebe5]">
                      <div
                        className={`h-full rounded-full transition-all duration-500 ${
                          isReal ? "bg-emerald-600" : isFake ? "bg-rose-600" : "bg-amber-500"
                        }`}
                        style={{ width: `${Math.min(100, Math.max(0, result.p_real * 100))}%` }}
                      />
                    </div>
                    {advisoryNotes.length > 0 && (
                      <div className="mt-4 flex items-start gap-2.5 rounded-xl border border-amber-600/20 bg-amber-500/10 p-3 text-xs leading-relaxed text-amber-900">
                        <Icon name="info" className="mt-0.5 h-4 w-4 shrink-0 text-amber-700" />
                        <div>{advisoryNotes.join(" ")}</div>
                      </div>
                    )}
                  </div>

                  <div className="rounded-2xl border border-[#d8e0d9] bg-white/70 p-5 shadow-sm">
                    <div className="flex items-center justify-between border-b border-[#dfe5df] pb-3">
                      <div>
                        <h2 className="font-semibold text-[#123c2d]">Seven-model ensemble votes</h2>
                        <p className="text-xs text-[#718078]">Individual model probabilities for this text</p>
                      </div>
                      <span className="rounded-full bg-emerald-50 px-3 py-1 font-mono text-xs font-semibold text-emerald-800">
                        {result.votes.filter((v) => v.p_real > 0.5).length} of {result.votes.length} say real
                      </span>
                    </div>
                    <div className="mt-4 grid gap-3 sm:grid-cols-2">
                      {result.votes.map((v) => {
                        const real = v.p_real > 0.5;
                        return (
                          <div
                            key={v.model}
                            className="flex items-center justify-between rounded-xl border border-[#e1e6e1] bg-[#fafbf7] px-3.5 py-2.5"
                          >
                            <span className="text-xs font-medium text-[#29483c]">{v.model}</span>
                            <div className="flex items-center gap-2">
                              <span
                                className={`rounded-md px-2 py-0.5 text-[11px] font-semibold ${
                                  real ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800"
                                }`}
                              >
                                {real ? "Real" : "Fake"}
                              </span>
                              <span className="font-mono text-xs text-[#607068]">
                                {(v.p_real * 100).toFixed(0)}%
                              </span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  <div className="rounded-2xl border border-[#d8e0d9] bg-white/70 p-5 shadow-sm">
                    <div className="flex flex-col gap-2 border-b border-[#dfe5df] pb-3 sm:flex-row sm:items-center sm:justify-between">
                      <div>
                        <h2 className="font-semibold text-[#123c2d]">Words influencing the result</h2>
                        <p className="text-xs text-[#718078]">
                          Vocabulary signals from the trained Logistic Regression model
                        </p>
                      </div>
                      <div className="flex items-center gap-2 text-xs">
                        <span className="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 font-medium text-emerald-800">
                          <span className="h-2 w-2 rounded-full bg-emerald-600" />
                          Real-leaning
                        </span>
                        <span className="inline-flex items-center gap-1.5 rounded-full bg-rose-100 px-2.5 py-1 font-medium text-rose-800">
                          <span className="h-2 w-2 rounded-full bg-rose-600" />
                          Fake-leaning
                        </span>
                      </div>
                    </div>
                    <div className="mt-4 max-h-64 overflow-y-auto rounded-xl border border-[#dfe5df] bg-[#fafbf7] p-4 text-xs leading-relaxed text-[#1e382d]">
                      {article.split(/(\s+)/).map((tok, i) => {
                        const cleanTok = tok.toLowerCase().replace(/[^a-z]/g, "");
                        const weight = result.words[cleanTok] || 0;
                        if (!tok.trim() || Math.abs(weight) < wordThreshold || !wordThreshold) {
                          return <span key={i}>{tok}</span>;
                        }
                        const isRealWord = weight > 0;
                        return (
                          <mark
                            key={i}
                            title={`${isRealWord ? "Real" : "Fake"}-leaning (${weight.toFixed(2)})`}
                            className={`rounded px-1 py-0.5 font-medium ${
                              isRealWord
                                ? "bg-emerald-200/60 text-emerald-950"
                                : "bg-rose-200/60 text-rose-950"
                            }`}
                          >
                            {tok}
                          </mark>
                        );
                      })}
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>

        <section className="border-y border-[#d9e0d8] bg-[#e9eee7] px-5 py-16 sm:px-8">
          <div className="mx-auto grid max-w-6xl gap-10 md:grid-cols-3">
            {[
              ["01", "Paste the article", "Copy the full text from any news source into the analyzer above."],
              ["02", "Seven models review", "Independent algorithms evaluate language, patterns, and credibility signals."],
              ["03", "Get a clear verdict", "Receive one concise confidence score without the technical clutter."],
            ].map(([number, title, description]) => (
              <div className="relative pl-14" key={number}>
                <span className="absolute left-0 top-0 font-mono text-sm font-semibold text-emerald-500">{number}</span>
                <h2 className="text-base font-semibold text-[#123c2d]">{title}</h2>
                <p className="mt-2 text-sm leading-6 text-[#607068]">{description}</p>
              </div>
            ))}
          </div>
        </section>
      </main>
      <Footer />
    </>
  );
}

const defaultModels = [
  { name: "Logistic Regression", accuracy: 94.2, precision: 93.8, recall: 94.5 },
  { name: "Support Vector Machine", accuracy: 92.8, precision: 92.1, recall: 93.2 },
  { name: "Passive Aggressive", accuracy: 91.7, precision: 90.9, recall: 92.4 },
  { name: "Random Forest", accuracy: 90.5, precision: 91.2, recall: 89.8 },
  { name: "Naive Bayes", accuracy: 88.9, precision: 87.6, recall: 90.1 },
  { name: "Gradient Boosting", accuracy: 93.4, precision: 92.9, recall: 93.8 },
  { name: "Linear SVM", accuracy: 92.1, precision: 91.7, recall: 92.5 },
];

function Accuracy() {
  const [info, setInfo] = useState<InfoData | null>(null);

  useEffect(() => {
    fetch("/api/info")
      .then((res) => (res.ok ? res.json() : null))
      .then((data: InfoData | null) => {
        if (data && data.models) {
          setInfo(data);
        }
      })
      .catch(() => {});
  }, []);

  const ensembleModel = info?.models?.find((m) => m.name.toLowerCase().includes("ensemble"));
  const modelList = info?.models
    ? [...info.models]
        .filter((m) => !m.name.toLowerCase().includes("ensemble"))
        .sort((a, b) => b.f1 - a.f1)
        .map((m) => ({
          name: m.name,
          accuracy: +(m.accuracy * 100).toFixed(1),
          precision: +(m.precision * 100).toFixed(1),
          recall: +(m.recall * 100).toFixed(1),
        }))
    : defaultModels;

  const ensembleAccuracy = ensembleModel
    ? `${(ensembleModel.accuracy * 100).toFixed(1)}%`
    : "92.0%";
  const evaluatedCount = info?.n_test ? `${info.n_test.toLocaleString()}` : "40K+";
  const modelCount = modelList.length ? `${modelList.length}` : "7";

  return (
    <>
      <Header page="accuracy" />
      <main className="relative overflow-hidden px-5 pb-24 pt-20 sm:px-8 sm:pt-24">
        <div className="glow absolute -right-80 -top-52 h-[44rem] w-[44rem] rounded-full opacity-40" />
        <div className="relative mx-auto max-w-6xl">
          <button
            onClick={() => navigate("/")}
            className="mb-10 flex items-center gap-2 text-sm text-[#6b7a72] transition hover:text-[#064e3b]"
          >
            <span className="rotate-180">
              <Icon name="arrow" className="h-4 w-4" />
            </span>
            Back to analyzer
          </button>

          <div className="max-w-3xl">
            <div className="eyebrow mb-6 w-fit">Model transparency</div>
            <h1 className="text-4xl font-semibold tracking-[-0.04em] text-[#123c2d] sm:text-6xl">
              Accuracy, model by model.
            </h1>
            <p className="mt-6 max-w-2xl text-lg leading-8 text-[#5d7066]">
              Get Legit combines seven independently trained classifiers. Explore how each algorithm
              performs on our held-out evaluation dataset.
            </p>
          </div>

          <div className="mt-14 grid gap-4 sm:grid-cols-3">
            {[
              [ensembleAccuracy, "Ensemble accuracy"],
              [evaluatedCount, "Articles evaluated"],
              [modelCount, "Independent models"],
            ].map(([value, label]) => (
              <div className="metric-card rounded-2xl border border-[#d8e0d9] p-6" key={label}>
                <p className="text-3xl font-semibold tracking-[-0.04em] text-[#123c2d]">{value}</p>
                <p className="mt-1 text-sm text-[#6b7a72]">{label}</p>
              </div>
            ))}
          </div>

          <div className="mt-8 overflow-hidden rounded-2xl border border-[#d8e0d9] bg-white/70 shadow-sm">
            <div className="border-b border-[#dfe5df] px-6 py-5">
              <h2 className="font-semibold text-[#123c2d]">Individual model performance</h2>
              <p className="mt-1 text-sm text-[#718078]">
                {info?.dataset ? `Evaluation split · ${info.dataset}` : "Evaluation split · balanced dataset · updated recently"}
              </p>
            </div>
            <div className="hidden grid-cols-[1.6fr_1fr_1fr_1fr] border-b border-[#dfe5df] bg-[#f1f3ed] px-6 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-[#75847b] sm:grid">
              <span>Model</span>
              <span>Accuracy</span>
              <span>Precision</span>
              <span>Recall</span>
            </div>
            {modelList.map((model, index) => (
              <div
                className="grid gap-5 border-b border-[#e1e6e1] px-6 py-5 last:border-0 sm:grid-cols-[1.6fr_1fr_1fr_1fr] sm:items-center"
                key={model.name}
              >
                <div className="flex items-center gap-3">
                  <span className="grid h-8 w-8 place-items-center rounded-lg bg-emerald-500/10 font-mono text-xs text-emerald-700">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span className="font-medium text-[#29483c]">{model.name}</span>
                </div>
                {[model.accuracy, model.precision, model.recall].map((value, metricIndex) => (
                  <div key={metricIndex}>
                    <span className="mb-1 block text-xs text-[#829088] sm:hidden">
                      {["Accuracy", "Precision", "Recall"][metricIndex]}
                    </span>
                    <span className={metricIndex === 0 ? "font-semibold text-emerald-700" : "text-[#617168]"}>
                      {value}%
                    </span>
                  </div>
                ))}
              </div>
            ))}
          </div>

          <p className="mt-5 text-xs leading-5 text-[#7a8980]">
            Performance figures reflect held-out test evaluation{info?.dataset ? ` on ${info.dataset}` : ""}. Results should support, not replace, independent source verification.
          </p>
        </div>
      </main>
      <Footer />
    </>
  );
}

function Footer() {
  return (
    <footer className="border-t border-[#d8dfd8] bg-[#f0ece3] px-5 py-8 sm:px-8">
      <div className="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-[#718078] sm:flex-row sm:items-center sm:justify-between">
        <span>© 2025 Get Legit Intelligence</span>
        <span>Built for clearer, more informed reading.</span>
      </div>
    </footer>
  );
}

export default function App() {
  const [path, setPath] = useState(window.location.pathname);

  useEffect(() => {
    const handleNavigation = () => setPath(window.location.pathname);
    window.addEventListener("popstate", handleNavigation);
    return () => window.removeEventListener("popstate", handleNavigation);
  }, []);

  return <div className="min-h-screen bg-[#f7f3ea]">{path === "/accuracy" ? <Accuracy /> : <Analyzer />}</div>;
}
